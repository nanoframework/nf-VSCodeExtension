// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"type": "shell",
			"command": "wsl.exe",
			"args": [
				"--distribution",
				"Ubuntu-24.04",
				"--cd",
				"${workspaceFolder}",
				"--exec",
				"bash",
				"--noprofile",
				"--norc",
				"-c",
				"export PATH=\"$HOME/.local/bin:$PATH\" && npm run watch"
			],
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
