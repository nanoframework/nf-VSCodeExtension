// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build debug bridges",
			"type": "shell",
			"command": "npx gulp build-debug-bridge",
			"problemMatcher": []
		},
		{
			"label": "watch",
			"type": "npm",
			"script": "watch",
			"dependsOn": "build debug bridges",
			"dependsOrder": "sequence",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
